# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# URL dan ANON_KEY: Supabase Dashboard -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=

# SERVICE_ROLE_KEY hanya digunakan di sisi server (Server Actions / Route Handler).
# JANGAN PERNAH menggunakan prefix NEXT_PUBLIC_ pada kunci ini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Personal Access Token untuk Supabase MCP server.
# Dashboard -> Account -> Personal Access Tokens -> scopes: read:projects, mcp-tools
SUPABASE_ACCESS_TOKEN=

# Project ref untuk Supabase MCP dan script migrasi/verifikasi.
# Dashboard -> Project Settings -> Reference (https://<ref>.supabase.co)
SUPABASE_PROJECT_REF=

# ==========================================
# CLOUDINARY CONFIGURATION
# ==========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# STITCH MCP
# ==========================================
STITCH_API_KEY=

# ==========================================
# WORKSHOP LOCATION (GPS VALIDATION)
# ==========================================
NEXT_PUBLIC_WORKSHOP_LAT=-6.4000000
NEXT_PUBLIC_WORKSHOP_LNG=106.8000000
NEXT_PUBLIC_WORKSHOP_RADIUS_METERS=30

# ==========================================
# APP URL CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000